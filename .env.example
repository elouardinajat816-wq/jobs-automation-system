# النظام يعمل مع SQLite افتراضياً لتسهيل التطوير
# ويمكن استبداله لاحقاً بـ PostgreSQL أو Supabase بسهولة.
DATABASE_URL=sqlite:///jobs_system.db

# إعدادات البريد الإلكتروني (استبدل بالقيم الحقيقية)
SYSTEM_EMAIL=jobs@yourdomain.com
SYSTEM_PASSWORD=your_app_password
EMAIL_SERVER_HOST=imap.gmail.com
SMTP_SERVER_HOST=smtp.gmail.com
SMTP_PORT=587

# إعدادات التوقيت
FETCH_INTERVAL_MINUTES=30
DISPATCH_INTERVAL_MINUTES=15
LOG_LEVEL=INFO
